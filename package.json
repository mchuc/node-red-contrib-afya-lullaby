    "fade",
    "light",
    "fall asleep",
    "wake up",
    "sunrise",
    "children"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "afya-lullaby": "afya-lullaby/afya-lullaby.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
